rules_version = '2';

// Regras do Wynd / FLUXO, versao 2: acesso por familia e por dono.
// Cada registro financeiro tem familyId (id do administrador da familia) e ownerUid (dono).
// - Administrador da familia (uid == familyId): le e edita tudo da propria familia.
// - Membro: le e edita so o que e dele (ownerUid) ou foi compartilhado com ele (sharedWith, so leitura).
// - Administrador geral (superAdmin): gerencia contas e familias, mas NAO le dinheiro de ninguem.
// Ordem de uso: primeiro rodar "Preparar dados" no app (marca familyId/ownerUid), so depois publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- ajudantes
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function active() {
      return hasProfile() && profile().get('status', 'ativo') != 'inativo';
    }

    function role() {
      return profile().get('role', 'viewer');
    }

    function myFamily() {
      return profile().get('familyId', '');
    }

    function isSuperAdmin() {
      return active() && profile().get('superAdmin', false) == true;
    }

    // Administrador da familia: o id dele e o id da familia.
    function isFamilyAdmin() {
      return active() && myFamily() != '' && myFamily() == request.auth.uid;
    }

    function isManager() {
      return active() && (role() == 'admin' || role() == 'gerente');
    }

    function storedPerms() {
      return profile().get('permissions', {});
    }

    function hasStored() {
      return storedPerms().size() > 0;
    }

    // modulo: 'transactions', 'accounts', 'cards', 'subscriptions', 'settings'...  acao: 'view' ou 'edit'
    function can(module, action) {
      return active() && (
        role() == 'admin'
        || (hasStored() && (module in storedPerms()) && (action in storedPerms()[module]))
        || (!hasStored() && (
              (role() in ['usuario', 'gerente'] && module in ['transactions', 'accounts', 'cards', 'subscriptions'])
              || (role() == 'viewer' && action == 'view')
           ))
      );
    }

    // ---------------------------------------------------------------- registros financeiros
    // Dono do registro existente, ou o administrador da familia dele.
    function ownsExisting() {
      return isFamilyAdmin() || resource.data.get('ownerUid', '') == request.auth.uid;
    }

    // Quem pode LER: mesma familia e (administrador da familia, dono ou compartilhado).
    function canReadRecord(module) {
      return can(module, 'view')
        && myFamily() != ''
        && resource.data.get('familyId', '') == myFamily()
        && (ownsExisting() || request.auth.uid in resource.data.get('sharedWith', []));
    }

    // Campos de controle bem formados.
    function validMeta() {
      let d = request.resource.data;
      return d.get('familyId', '') is string
        && d.get('ownerUid', '') is string
        && d.get('sharedWith', []) is list
        && d.get('sharedWith', []).size() <= 20;
    }

    function canCreateRecord(module) {
      let d = request.resource.data;
      return can(module, 'edit')
        && myFamily() != ''
        && d.get('familyId', '') == myFamily()
        && validMeta()
        && (isFamilyAdmin() || d.get('ownerUid', '') == request.auth.uid);
    }

    function canUpdateRecord(module) {
      let d = request.resource.data;
      return can(module, 'edit')
        && myFamily() != ''
        && resource.data.get('familyId', '') == myFamily()
        && d.get('familyId', '') == resource.data.get('familyId', '')
        && validMeta()
        && ownsExisting()
        // Membro nao troca o dono nem quem recebe compartilhamento; so o administrador da familia.
        && (isFamilyAdmin()
            || (d.get('ownerUid', '') == resource.data.get('ownerUid', '')
                && d.get('sharedWith', []) == resource.data.get('sharedWith', [])));
    }

    function canDeleteRecord(module) {
      return can(module, 'edit')
        && myFamily() != ''
        && resource.data.get('familyId', '') == myFamily()
        && ownsExisting();
    }

    match /transactions/{id} {
      allow read: if canReadRecord('transactions');
      allow create: if canCreateRecord('transactions');
      allow update: if canUpdateRecord('transactions');
      allow delete: if canDeleteRecord('transactions');
    }

    match /accounts/{id} {
      allow read: if canReadRecord('accounts');
      allow create: if canCreateRecord('accounts');
      allow update: if canUpdateRecord('accounts');
      allow delete: if canDeleteRecord('accounts');
    }

    match /cards/{id} {
      allow read: if canReadRecord('cards');
      allow create: if canCreateRecord('cards');
      allow update: if canUpdateRecord('cards');
      allow delete: if canDeleteRecord('cards');
    }

    match /paidInvoices/{id} {
      allow read: if canReadRecord('cards');
      allow create: if canCreateRecord('cards');
      allow update: if canUpdateRecord('cards');
      allow delete: if canDeleteRecord('cards');
    }

    match /subscriptions/{id} {
      allow read: if canReadRecord('subscriptions');
      allow create: if canCreateRecord('subscriptions');
      allow update: if canUpdateRecord('subscriptions');
      allow delete: if canDeleteRecord('subscriptions');
    }

    // Lembretes de contas a pagar (mesma permissao das fixas)
    match /reminders/{id} {
      allow read: if canReadRecord('subscriptions');
      allow create: if canCreateRecord('subscriptions');
      allow update: if canUpdateRecord('subscriptions');
      allow delete: if canDeleteRecord('subscriptions');
    }

    // Metas de poupanca (mesma permissao de contas)
    match /goals/{id} {
      allow read: if canReadRecord('accounts');
      allow create: if canCreateRecord('accounts');
      allow update: if canUpdateRecord('accounts');
      allow delete: if canDeleteRecord('accounts');
    }

    // Acertos de contas entre pessoas (tela Pessoas do app): mesma permissao das transacoes.
    match /settlements/{id} {
      allow read: if canReadRecord('transactions');
      allow create: if canCreateRecord('transactions');
      allow update: if canUpdateRecord('transactions');
      allow delete: if canDeleteRecord('transactions');
    }

    // Tags (nome e cor) criadas no app: mesma permissao das transacoes.
    match /tags/{id} {
      allow read: if canReadRecord('transactions');
      allow create: if canCreateRecord('transactions');
      allow update: if canUpdateRecord('transactions');
      allow delete: if canDeleteRecord('transactions');
    }

    // Aviso de manutencao e versao minima do app (config/app). Qualquer um le; so o Console do Firebase escreve.
    match /config/{id} {
      allow get: if true;
      allow list, write: if false;
    }

    // ---------------------------------------------------------------- cadastro de usuarios
    function sameFamilyUser() {
      return myFamily() != '' && resource.data.get('familyId', '') == myFamily();
    }

    // Campos que ninguem muda no proprio cadastro.
    function selfLocked() {
      return ['role', 'permissions', 'status', 'allowedPersons', 'familyId', 'superAdmin', 'person'];
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSuperAdmin() || (isManager() && sameFamilyUser()));
      // Lista: administrador geral ve todos; administrador/gerente so a propria familia (a consulta precisa filtrar por familyId).
      allow list: if isSuperAdmin() || (isManager() && sameFamilyUser());
      allow create: if isSuperAdmin()
        || (isFamilyAdmin() && request.resource.data.get('familyId', '') == myFamily()
            && !('superAdmin' in request.resource.data));
      allow delete: if request.auth.uid != uid && (isSuperAdmin() || (isFamilyAdmin() && sameFamilyUser()));
      allow update: if isSuperAdmin()
        || (isFamilyAdmin() && sameFamilyUser() && request.auth.uid != uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['superAdmin', 'familyId']))
        || (isManager() && sameFamilyUser() && request.auth.uid != uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'status', 'superAdmin', 'familyId']))
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(selfLocked()));
    }

    // Atalhos de login (usuario, CPF, e-mail) -> e-mail. O login precisa ler ANTES de entrar (um por vez, sem listar).
    match /user_lookup/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isManager() || isSuperAdmin();
    }

    // ---------------------------------------------------------------- compartilhados por enquanto
    // Nomes de pessoas e configuracoes ainda sao globais; passam a ser por familia numa etapa seguinte.
    match /persons/{id} {
      allow read: if active();
      allow create, update, delete: if isManager();
    }

    match /settings/{id} {
      allow read: if active();
      allow create, update, delete: if isManager() || can('settings', 'edit') || can('transactions', 'edit');
    }

    // Todo o resto fica fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}