rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'ativo') in ['inativo', 'pendente']);
    }

    function isAdmin() {
      return isActiveUser() && myUser().role == 'admin';
    }

    function isGerente() {
      return isActiveUser() && myUser().role == 'gerente';
    }

    // Qualquer pessoa com cadastro ativo no sistema (documento em /users com status != 'inativo' e != 'pendente').
    function isMember() {
      return isActiveUser();
    }

    // Compatibilidade: continua aceitando comparação exata (owner == meu
    // nome/username/pessoa) pra documentos antigos que ainda não foram
    // salvos de novo e por isso não têm personKeys/ownerKey ainda.
    function isMyPersonLegacy(personName) {
      return isSignedIn() && (
        personName == myUser().person ||
        personName == myUser().name ||
        personName == myUser().username
      );
    }

    // Um gerente sem "allowedPersonKeys" definido (ou lista vazia) vê todo
    // mundo, do mesmo jeito que a tela de Usuários trata campo em branco
    // como "sem restrição". Com lista definida, só vê quem está nela.
    function gerenteSemRestricao() {
      return !('allowedPersonKeys' in myUser()) || myUser().allowedPersonKeys.size() == 0;
    }

    function gerentePodeVerChave(personKey) {
      return isGerente() && (gerenteSemRestricao() || personKey in myUser().allowedPersonKeys);
    }

    function gerentePodeVerChaves(personKeys) {
      return isGerente() && (gerenteSemRestricao() || personKeys.hasAny(myUser().allowedPersonKeys));
    }

    // --- dono por campo único (accounts/cards: ownerKey normalizado) ---
    function donoSouEu(data) {
      return isSignedIn() && (
        (('ownerKey' in data) && ('personKeys' in myUser()) && data.ownerKey in myUser().personKeys) ||
        (!('ownerKey' in data) && isMyPersonLegacy(data.owner))
      );
    }

    function donoPermitidoGerente(data) {
      return ('ownerKey' in data) ? gerentePodeVerChave(data.ownerKey) : isGerente();
    }

    // --- pessoa por campo com possível lista (transactions/subscriptions:
    //     personKeys normalizado, suporta "Eduardo, Mãe") ---
    function souUmaDasPessoas(data) {
      return isSignedIn() && (
        (('personKeys' in data) && ('personKeys' in myUser()) && data.personKeys.hasAny(myUser().personKeys)) ||
        (!('personKeys' in data) && isMyPersonLegacy(data.person))
      );
    }

    function pessoaPermitidaGerente(data) {
      return ('personKeys' in data) ? gerentePodeVerChaves(data.personKeys) : isGerente();
    }

    // --- users: dados completos (nome, e-mail, cpf, cargo, permissões) ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isGerente());
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.permissions == resource.data.permissions
                      && request.resource.data.allowedPersonKeys == resource.data.allowedPersonKeys);
      allow delete: if isAdmin();
    }

    // --- user_lookup: SOMENTE mapeamento identificador -> email de login ---
    match /user_lookup/{lookupId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // --- accounts: leitura liberada pra quem tem cadastro (a tela filtra por dono, porque o
    //     Firestore recusa a lista inteira quando a regra depende do dono de cada documento);
    //     escrita continua restrita por dono (owner/ownerKey) ---
    match /accounts/{id} {
      allow read: if isMember();
      allow create: if isAdmin() || donoSouEu(request.resource.data) || donoPermitidoGerente(request.resource.data);
      allow update, delete: if isAdmin() || donoSouEu(resource.data) || donoPermitidoGerente(resource.data);
      // O saldo guardado da conta (computedBalance) é recalculado por quem lança uma transação
      // nela, mesmo quando a conta é de outra pessoa. Por esse caminho só esse campo pode mudar.
      allow update: if isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['computedBalance']);
    }

    // --- cards: leitura liberada pra quem tem cadastro; escrita restrita por dono ---
    match /cards/{id} {
      allow read: if isMember();
      allow create: if isAdmin() || donoSouEu(request.resource.data) || donoPermitidoGerente(request.resource.data);
      allow update, delete: if isAdmin() || donoSouEu(resource.data) || donoPermitidoGerente(resource.data);
    }

    // --- transactions: leitura liberada pra quem tem cadastro (a tela filtra por pessoa);
    //     escrita restrita por autor (userId), pessoa(s) ou gerente autorizado ---
    match /transactions/{id} {
      allow read: if isMember();
      allow create: if isAdmin() || (
        isSignedIn() && (
          request.resource.data.userId == request.auth.uid ||
          souUmaDasPessoas(request.resource.data) ||
          pessoaPermitidaGerente(request.resource.data)
        )
      );
      allow update, delete: if isAdmin() ||
                            resource.data.userId == request.auth.uid ||
                            souUmaDasPessoas(resource.data) ||
                            pessoaPermitidaGerente(resource.data);
    }

    // --- subscriptions: leitura liberada pra quem tem cadastro; escrita restrita por
    //     pessoa(s) ou gerente autorizado ---
    match /subscriptions/{id} {
      allow read: if isMember();
      allow create: if isAdmin() || (isSignedIn() && (souUmaDasPessoas(request.resource.data) || pessoaPermitidaGerente(request.resource.data)));
      allow update, delete: if isAdmin() || souUmaDasPessoas(resource.data) || pessoaPermitidaGerente(resource.data);
    }

    // --- paidInvoices: controle de faturas pagas ---
    match /paidInvoices/{id} {
      allow read, write: if isMember();
    }

    // --- persons: catálogo de pessoas vinculadas ---
    match /persons/{id} {
      allow read: if isMember();
      allow write: if isAdmin() || isGerente();
    }

    // --- settings: configurações globais do sistema e categorias ---
    match /settings/{id} {
      allow read: if isMember();
      allow write: if isAdmin() || isGerente();
    }

    // --- _rate_limits: controle interno de tentativas por IP (somente Admin SDK) ---
    match /_rate_limits/{id} {
      allow read, write: if false;
    }

    // --- consentLogs: registros de aceite dos Termos e Política (somente Admin SDK) ---
    match /consentLogs/{id} {
      allow read, write: if false;
    }
  }
}
