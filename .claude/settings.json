{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Read(**/*service-account*.json)",
      "Read(**/*serviceAccount*.json)",
      "Read(**/*firebase-adminsdk*.json)",
      "Bash(git push *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(firebase deploy *)",
      "Bash(npx firebase deploy *)"
    ],
    "ask": [
      "Edit(./firestore.rules)",
      "Edit(./api/**)",
      "Edit(./src/context/AuthContext.tsx)",
      "Edit(./src/pages/Login.tsx)",
      "Edit(./src/pages/Users.tsx)",
      "Edit(./src/firebase.ts)",
      "Edit(./src/utils/scope.ts)",
      "Edit(./src/utils/permissions.ts)",
      "Edit(./src/legal/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Grep|Glob|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/bloquear-segredos.mjs\""
          }
        ]
      }
    ]
  }
}
